{
  "name": "flick-typing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck:worker": "tsc -p worker --noEmit",
    "format": "prettier --write index.html src tests worker stats.html vite.config.ts",
    "format:check": "prettier --check index.html src tests worker stats.html vite.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261015.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
