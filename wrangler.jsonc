{
  // Cloudflare Workers Builds が GitHub から `npm run build` → `npx wrangler deploy` で使う設定。
  // 名前はダッシュボードの Worker 名と同じにする(違うと別の Worker ができる)。
  "name": "flick-typing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flick-typing",
      "database_id": "3ad7a4e4-2c47-4a55-bc55-b05a5b46458c",
    },
  ],
  // API の回数制限(docs/spec-launch-hardening.md)。key は接続元の IP。period は 10 か 60 だけ。
  // namespace_id はアカウント内で数を共有する単位なので、ほかの Worker と同じ値にしない。
  "ratelimits": [
    { "name": "RL_WRITE", "namespace_id": "52201", "simple": { "limit": 20, "period": 60 } },
    { "name": "RL_NAME", "namespace_id": "52202", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_READ", "namespace_id": "52203", "simple": { "limit": 120, "period": 60 } },
  ],
  // Workers Logs(ダッシュボードの Observability)。docs/operations.md の「ログ」
  "observability": { "enabled": true },
  // main 以外のブランチは Workers Builds が `npx wrangler preview` でプレビューを作る。
  // プレビューの結果が本番のランキング・集計に混ざらないよう、別の D1 を使う。
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "flick-typing-preview",
        "database_id": "2da4238e-a92e-4c8b-845b-3957a2820bd2",
      },
    ],
  },
}
